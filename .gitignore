# Build output (every workspace)
**/target/
*.so

# Secrets: env files (except the template), keys, keypairs
.env
.env.*
!.env.example
*.pem
*.key
id.json
*keypair*.json

# Local validator ledgers
.local-ledger/
test-ledger/

# Generated: proofs written by the prover, the footer-dump plugin's raw stream
fixtures/proofs/*
!fixtures/proofs/.gitkeep
fixtures/local/footers.jsonl

# Personal notes, logs, coverage
notes/
scratch/
*.log
test-results/
coverage/
lcov.info
*.profraw
.DS_Store
